APP_BASE_URL=http://localhost:3000
FUNCTIONS_BASE_URL=http://localhost:5001/PROJECT_ID/us-central1

# Inbound email intake (Postmark webhook)
POSTMARK_INBOUND_WEBHOOK_SECRET=
POSTMARK_INBOUND_ALLOWED_RECIPIENTS=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
# Optional: redirect all outbound mail to one address for safe testing
POSTMARK_SAFE_MODE_REDIRECT=

# One-time first-admin bootstrap (see docs/first-admin-bootstrap.md).
# Clear/rotate after use.
BOOTSTRAP_PLATFORM_ADMIN_SECRET=

# App URL used in outbound email links (falls back to APP_BASE_URL)
NEXUS_APP_URL=

# DANGER: enables seed/test-account endpoints and relaxes the SSRF guard.
# Only ever set to true against emulators or a disposable sandbox project.
ALLOW_LOCAL_ONLY_FUNCTIONS=false
